# ── Chrome 프로필 경로 ──────────────────────────────────
# 로컬 Chrome 로그인 세션 재사용 (Threads, X, Instagram)
CHROME_PROFILE_PATH=C:/Chrome_Profile_Archive

# ── YouTube Data API v3 ─────────────────────────────────
# console.cloud.google.com → YouTube Data API v3 활성화 → API 키 발급 (무료 10,000 유닛/일)
YOUTUBE_API_KEY=

# 수집할 YouTube 검색 키워드 (쉼표 구분)
YOUTUBE_KEYWORDS=마케팅,퍼스널브랜딩,부업,온라인비즈니스,콘텐츠마케팅

# ── Google Sheets ───────────────────────────────────────
# Service Account 키 파일 경로 (console.cloud.google.com에서 발급)
GOOGLE_CREDENTIALS_PATH=./credentials.json

# Sheets URL에서 복사: docs.google.com/spreadsheets/d/[이 부분]/edit
SPREADSHEET_ID=

# ── Telegram 알림 (선택) ────────────────────────────────
# @BotFather → /newbot → 토큰 발급
TELEGRAM_BOT_TOKEN=

# @userinfobot → Chat ID 확인
TELEGRAM_CHAT_ID=

# ── 수집 기준 ────────────────────────────────────────────
# 최소 좋아요 (Threads, X, Instagram)
MIN_LIKES=500

# 최소 조회수 (YouTube)
YOUTUBE_MIN_VIEWS=50000

# 플랫폼당 최대 수집 개수
MAX_ITEMS_PER_PLATFORM=15

# Instagram 사용자명 (자신의 팔로잉 피드 대신 특정 계정 수집 시)
# 비워두면 팔로잉 피드 사용
INSTAGRAM_TARGET_ACCOUNTS=
